# Required
TELEGRAM_BOT_TOKEN=123456:your-bot-token-from-BotFather
OWNER_TELEGRAM_ID=123456789

# Where the sqlite file lives. Locally this can be anything; on Railway it
# must point inside the mounted Volume so data survives redeploys.
DB_PATH=data/ptas.db

# Leave PUBLIC_BASE_URL unset to run in long-polling mode (default, fine for
# local dev). Set it on Railway to switch to webhook mode, e.g.
# https://your-app.up.railway.app — and set TELEGRAM_WEBHOOK_SECRET to a
# random string (it becomes part of the webhook URL path).
PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=

PORT=8080

# Fixed utility rates used to compute every bill.
WATER_RATE_RIEL=2500
ELEC_RATE_RIEL=1500
USD_RATE_RIEL=4000
